.section nav_bar:
    ld horizontal, left
    md "<a href=\"/insite\"><img src=\"/insite/icon-wide.svg\" width=\"100px\"/></a>"
    exp
    md "[Home](/insite) | [Documentation](/insite/docs)"
    str

.section docs_index:
    ld vertical, left
    md "#### Contents"
    md "[Install](/insite/docs/install)"
    md "[Creating](/insite/docs/creating)"
    md "[Configuring](/insite/docs/configuring)"
    str

.page "Home", "/":
    jmp nav_bar
    ld horizontal, center
    mdf "site/home.md"
    md "<img src=\"/insite/icon.svg\" style=\"margin: 40px;\">"
    str

.page "Documentation", "/docs/":
    jmp nav_bar
    ld horizontal, left
    jmp docs_index
    mdf "site/documentation/docs.md"
    exp
    str

.page "Install", "/docs/install":
    jmp nav_bar
    ld horizontal, left
    jmp docs_index
    mdf "site/documentation/install.md"
    exp
    str

.page "Creating", "/docs/creating":
    jmp nav_bar
    ld horizontal, left
    jmp docs_index
    mdf "site/documentation/creating.md"
    exp
    str

.page "Configuring", "/docs/configuring":
    jmp nav_bar
    ld horizontal, left
    jmp docs_index
    mdf "site/documentation/configuring.md"
    exp
    str
